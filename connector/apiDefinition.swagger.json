{
  "swagger": "2.0",
  "info": {
    "title": "Power BI MCP Bridge",
    "description": "Copilot Studio에서 Power BI Desktop 모델에 접근하는 MCP Bridge. 로컬 Power BI Desktop에 자동 연결을 지원하므로 별도의 연결 설정 없이 바로 도구(table_operations, dax_query_operations 등)를 사용할 수 있습니다.",
    "version": "1.0.0",
    "contact": {
      "name": "Dream I System",
      "url": "https://github.com/your-org/copilot-powerbi-desktop-mcp-bridge"
    }
  },
  "host": "localhost:5050",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/mcp/tools/list": {
      "post": {
        "operationId": "ListTools",
        "summary": "MCP 도구 목록 조회",
        "description": "사용 가능한 MCP 도구 목록을 반환합니다. Power BI 모델 작업에 사용할 수 있는 모든 도구와 그 파라미터 정보를 확인할 수 있습니다.",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "API Key (Bridge 설정에서 활성화한 경우)",
            "x-ms-summary": "API Key"
          }
        ],
        "responses": {
          "200": {
            "description": "도구 목록",
            "schema": {
              "type": "object",
              "properties": {
                "tools": {
                  "type": "array",
                  "description": "사용 가능한 도구 목록",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "도구 이름"
                      },
                      "description": {
                        "type": "string",
                        "description": "도구 설명"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": { "description": "MCP 서버 미연결" },
          "500": { "description": "내부 서버 오류" }
        }
      }
    },
    "/mcp/tools/call": {
      "post": {
        "operationId": "CallTool",
        "summary": "MCP 도구 실행",
        "description": "지정한 MCP 도구를 실행합니다. Power BI Desktop 자동 연결을 지원하여 별도의 connection_operations 호출 없이도 바로 사용할 수 있습니다. toolName으로 도구를 지정하고 toolArguments로 JSON 문자열 또는 객체 형태의 인자를 전달합니다. 대부분의 도구는 중첩된 request 객체 구조를 요구합니다.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["toolName", "toolArguments"],
              "properties": {
                "toolName": {
                  "type": "string",
                  "description": "실행할 MCP 도구 이름 (예: table_operations, dax_query_operations, column_operations, measure_operations, relationship_operations, batch_table_operations, connection_operations)",
                  "x-ms-summary": "도구 이름"
                },
                "toolArguments": {
                  "type": "object",
                  "description": "Tool arguments as JSON object. Set request.operation and add tool-specific parameters at the request level. The bridge will auto-restructure nested objects. Examples: For dax_query_operations Execute: set request.operation='Execute' and request.query='EVALUATE ...'. For relationship_operations Create: set request.operation='Create', request.fromTable, request.fromColumn, request.toTable, request.toColumn, request.crossFilteringBehavior.",
                  "x-ms-summary": "도구 인자",
                  "properties": {
                    "request": {
                      "type": "object",
                      "description": "요청 객체. operation 필수, 나머지는 도구/작업에 따라 선택적 사용.",
                      "properties": {
                        "operation": {
                          "type": "string",
                          "description": "Operation type: List, Create, Update, Delete, Execute, Validate, Help, Get, Refresh, Rename, etc."
                        },
                        "query": {
                          "type": "string",
                          "description": "DAX query string. Required for dax_query_operations Execute/Validate."
                        },
                        "tableName": {
                          "type": "string",
                          "description": "Target table name. Used by column_operations, table_operations, measure_operations, partition_operations."
                        },
                        "partitionName": {
                          "type": "string",
                          "description": "Partition name. Used by partition_operations."
                        },
                        "name": {
                          "type": "string",
                          "description": "Object name (measure, etc.). Used by measure_operations."
                        },
                        "newName": {
                          "type": "string",
                          "description": "New name for rename operations."
                        },
                        "expression": {
                          "type": "string",
                          "description": "DAX expression for measures or M expression for partitions."
                        },
                        "description": {
                          "type": "string",
                          "description": "Description for measures or tables."
                        },
                        "formatString": {
                          "type": "string",
                          "description": "Format string for measures."
                        },
                        "displayFolder": {
                          "type": "string",
                          "description": "Display folder for measures."
                        },
                        "isHidden": {
                          "type": "boolean",
                          "description": "Whether to hide the object."
                        },
                        "connectionString": {
                          "type": "string",
                          "description": "Connection string for connection_operations Connect."
                        },
                        "fromTable": {
                          "type": "string",
                          "description": "Source (Many-side) table for relationship_operations Create."
                        },
                        "fromColumn": {
                          "type": "string",
                          "description": "Source (Many-side) column for relationship_operations Create."
                        },
                        "toTable": {
                          "type": "string",
                          "description": "Target (One-side) table for relationship_operations Create."
                        },
                        "toColumn": {
                          "type": "string",
                          "description": "Target (One-side) column for relationship_operations Create."
                        },
                        "crossFilteringBehavior": {
                          "type": "string",
                          "description": "Filter direction: OneDirection or BothDirections. For relationship_operations."
                        },
                        "relationshipName": {
                          "type": "string",
                          "description": "Existing relationship name/ID for Update/Delete. For relationship_operations."
                        },
                        "isActive": {
                          "type": "boolean",
                          "description": "Whether relationship is active. For relationship_operations."
                        },
                        "securityFilteringBehavior": {
                          "type": "string",
                          "description": "Security filtering: OneDirection or BothDirections. For relationship_operations."
                        },
                        "sourceType": {
                          "type": "string",
                          "description": "Partition source type (M, Calculated, etc.)."
                        },
                        "mode": {
                          "type": "string",
                          "description": "Partition mode (Import, DirectQuery, etc.)."
                        },
                        "columns": {
                          "type": "string",
                          "description": "JSON string array of column definitions for table_operations Create. Example: [{\"name\":\"Col1\",\"dataType\":\"String\"}]"
                        },
                        "partitions": {
                          "type": "string",
                          "description": "JSON string array of partition definitions for table_operations Create. Example: [{\"name\":\"Part1\",\"sourceType\":\"M\",\"expression\":\"...\"}]"
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "type": "string",
            "description": "API Key (Bridge 설정에서 활성화한 경우)",
            "x-ms-summary": "API Key"
          }
        ],
        "responses": {
          "200": {
            "description": "도구 실행 결과",
            "schema": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "array",
                  "description": "실행 결과 컨텐츠",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "컨텐츠 타입 (text 등)"
                      },
                      "text": {
                        "type": "string",
                        "description": "결과 텍스트"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "잘못된 요청" },
          "502": { "description": "MCP 서버 미연결" },
          "504": { "description": "요청 시간 초과" },
          "500": { "description": "내부 서버 오류" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthCheck",
        "summary": "Bridge 상태 확인",
        "description": "Bridge 서버와 MCP 연결 상태를 확인합니다",
        "parameters": [],
        "responses": {
          "200": {
            "description": "상태 정보",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "description": "Bridge 상태 (ok, degraded, error)"
                },
                "bridge": {
                  "type": "object",
                  "description": "Bridge 정보",
                  "properties": {
                    "version": {
                      "type": "string",
                      "description": "Bridge 버전"
                    },
                    "uptime": {
                      "type": "number",
                      "description": "가동 시간 (초)"
                    }
                  }
                },
                "mcp": {
                  "type": "object",
                  "description": "MCP 서버 상태",
                  "properties": {
                    "state": {
                      "type": "string",
                      "description": "MCP 프로세스 상태 (stopped, starting, running, error)",
                      "x-ms-summary": "MCP 상태"
                    },
                    "pid": {
                      "type": "integer",
                      "description": "프로세스 ID",
                      "x-ms-summary": "프로세스 ID"
                    },
                    "command": {
                      "type": "string",
                      "description": "MCP 실행 명령어",
                      "x-ms-summary": "MCP 명령어"
                    }
                  }
                },
                "powerbi": {
                  "type": "object",
                  "description": "Power BI Desktop 연결 상태",
                  "properties": {
                    "connected": {
                      "type": "boolean",
                      "description": "Power BI Desktop 연결 여부",
                      "x-ms-summary": "Power BI 연결"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "MCP 프로세스 미준비 (degraded 상태)"
          }
        }
      }
    }
  },
  "definitions": {},
  "securityDefinitions": {
    "API Key": {
      "type": "apiKey",
      "in": "header",
      "name": "X-API-Key"
    }
  },
  "security": [],
  "tags": []
}
