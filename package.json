{
  "name": "copilot-powerbi-desktop-mcp-bridge",
  "version": "1.1.0",
  "description": "HTTP Bridge that connects Copilot Studio to Power BI Desktop via MCP (Model Context Protocol)",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rimraf dist",
    "lint": "eslint src/",
    "pkg:build": "npm run build && pkg dist/index.js --targets node18-win-x64 --output release/pbi-mcp-bridge.exe --config package.json"
  },
  "pkg": {
    "assets": ["config.example.yaml"],
    "targets": ["node18-win-x64"]
  },
  "keywords": ["mcp", "power-bi", "copilot", "bridge", "stdio", "http"],
  "author": "Dream I System",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "yaml": "^2.6.0",
    "winston": "^3.17.0",
    "dotenv": "^16.4.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.17.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.0",
    "rimraf": "^6.0.0",
    "pkg": "^5.8.1"
  }
}
